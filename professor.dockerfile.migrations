FROM mcr.microsoft.com/dotnet/sdk:8.0 AS migrator
WORKDIR /src

# Instala a ferramenta primeiro (camada de cache)
RUN dotnet tool install --global dotnet-ef --version 8.0.0
ENV PATH="${PATH}:/root/.dotnet/tools"

# Copia o projeto e restaura
COPY ["SistemaAcademicoProfessorMS/SistemaAcademicoProfessorMS.csproj", "SistemaAcademicoProfessorMS/"]
RUN dotnet restore "SistemaAcademicoProfessorMS/SistemaAcademicoProfessorMS.csproj"

# Copia o resto do código
COPY . .

WORKDIR "/src/SistemaAcademicoProfessorMS"

# O comando 'database update' precisa de uma string de conexão. 
# No Docker Compose, passamos via variável de ambiente DB_CONNECTION_STRING.
# Certifique-se que seu Program.cs ou DbContext entenda essa variável.
ENTRYPOINT ["dotnet", "ef", "database", "update"]